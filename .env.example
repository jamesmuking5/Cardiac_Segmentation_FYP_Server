# SECURITY WARNING: This is an example file. Copy this to .env and replace all values with secure credentials.
# NEVER commit the actual .env file to version control!

# ============================================
# CRITICAL SECURITY CONFIGURATION
# ============================================
# Generate secure random strings using:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Server Configuration
HOST=localhost
PORT=3000
NODE_ENV=development  # Set to 'production' for production deployment

# Session Secret - REQUIRED - MUST BE STRONG AND UNIQUE
# This is used to sign session cookies. If compromised, attackers can hijack user sessions.
SESSION_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_STRING_AT_LEAST_32_CHARS

# GPU Server Authentication Secret - REQUIRED - MUST BE STRONG AND UNIQUE
# This is used to sign JWT tokens for GPU server communication.
GPU_SERVER_AUTH_JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_STRING_AT_LEAST_32_CHARS

# Admin Password - CHANGE IMMEDIATELY AFTER FIRST LOGIN
# Must be at least 8 characters with at least 1 number and 1 special character
ADMIN_PASS=ChangeMe123!

# ============================================
# DATABASE CONFIGURATION
# ============================================

# MongoDB Connection String
# For local development: mongodb://localhost:27017/visheart
# For production: Use MongoDB Atlas with authentication and encryption
MONGODB_URI=mongodb://localhost:27017/visheart

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-secure-redis-password
REDIS_USERNAME=default
REDIS_CLOUD=false
REDIS_AWS=false

# ============================================
# AWS S3 CONFIGURATION
# ============================================
# WARNING: Keep these credentials secure. Never commit to git.
# Use IAM user with minimal S3 permissions only.

STORAGE_MODE=s3

# Development S3 Bucket
DEV_S3_BUCKET_NAME=your-dev-bucket-name
DEV_AWS_REGION=ap-southeast-1

# Production S3 Bucket
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_BUCKET_NAME=your-production-bucket-name
AWS_REGION=ap-southeast-1

# ============================================
# GPU SERVER CONFIGURATION
# ============================================
# Database GPU configuration takes precedence over these env vars

GPU_SERVER_HOST=your-gpu-server-hostname
GPU_SERVER_PORT=8000
GPU_SERVER_SSL=false
SERVER_ID_FOR_GPU_SERVER=cardiac-segmentation-server
GPU_SERVER_IDENTITY=visheart-gpu-inference

# Callback URL for GPU server to send results
CALLBACK_URL=https://your-domain.com:3000/

# ============================================
# CORS CONFIGURATION
# ============================================
# Comma-separated list of allowed origins for production
# Example: http://localhost:5173,https://your-domain.com
CORS_ORIGIN=http://localhost:5173

# If GPU server needs to make callbacks
GPU_SERVER_ORIGIN_FOR_CALLBACK=http://your-gpu-server:8000

# ============================================
# OPTIONAL CONFIGURATION
# ============================================

# Mesh format for 3D reconstruction (glb recommended)
RECONSTRUCTION_MESH_FORMAT=glb

# Guest user inactivity threshold (hours)
GUEST_INACTIVITY_THRESHOLD_HOURS=48

# JWT Configuration for GPU server
GPU_SERVER_JWT_REFRESH_INTERVAL=480000  # 8 minutes in milliseconds
GPU_SERVER_JWT_LIFETIME_SECONDS=600      # 10 minutes
